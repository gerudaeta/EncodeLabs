# Copy to .env and replace every value before starting the stack.
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
RABBITMQ_USER=replace_with_local_rabbitmq_user
RABBITMQ_PASSWORD=replace_with_local_rabbitmq_password
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=replace_with_local_database_name;Username=replace_with_local_database_user;Password=replace_with_local_database_password
RABBITMQ_URI=amqp://replace_with_local_rabbitmq_user:replace_with_local_rabbitmq_password@rabbitmq:5672/
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
